---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" current="">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">404</p>
      <h1>Not on the list</h1>
      <p class="lead">That page does not exist. Try the explorer or go back to the start.</p>
      <p class="row" style="margin-top:18px"><a class="btn primary" href="/explore">Explore</a><a class="btn" href="/">Home</a></p>
    </header>
  </div>
</Base>
