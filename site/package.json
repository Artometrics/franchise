  "scripts": {
    "sync:source": "node scripts/sync-source.mjs",
    "predev": "node scripts/copy-downloads.mjs",
    "dev": "astro dev --host",
    "prebuild": "node scripts/copy-downloads.mjs",
    "build": "astro build",
    "postbuild": "node scripts/verify-dist.mjs",
    "preview": "astro preview --host --port 4321",
