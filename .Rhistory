library(tidyverse)
library(httr)
library(jsonlite)
library(scales)
library(ggtext)
library(here)
library(httr2)
library(janitor)
# ── Artometrics color palette ──────────────────────────────────────
art_bg        <- "#FAFAF8"
art_cream     <- "#F2F0EB"
art_dark      <- "#1C1C1E"
art_mid       <- "#6B6B6B"
art_highlight <- "#C0392B"
art_secondary <- "#2C3E6B"
art_muted     <- "#D5D5D5"
# ── Artometrics ggplot2 theme ──────────────────────────────────────
theme_artometrics <- function() {
theme_minimal(base_family = "Helvetica") +
theme(
plot.background    = element_rect(fill = art_cream, color = NA),
panel.background   = element_rect(fill = art_cream, color = NA),
panel.grid.major   = element_line(color = art_muted, linewidth = 0.4),
panel.grid.minor   = element_blank(),
axis.text          = element_text(color = art_mid, size = 9),
axis.title         = element_text(color = art_dark, size = 10,
face = "bold"),
plot.title         = element_markdown(color = art_dark, size = 13,
face = "bold",
margin = margin(b = 6)),
plot.subtitle      = element_markdown(color = art_mid, size = 10,
margin = margin(b = 10)),
plot.caption       = element_text(color = art_mid, size = 8,
hjust = 0, margin = margin(t = 10)),
plot.caption.position = "plot",
plot.margin        = margin(t = 16, r = 16, b = 16, l = 16),
legend.background  = element_rect(fill = art_cream, color = NA),
legend.text        = element_text(color = art_mid, size = 8),
legend.title       = element_text(color = art_dark, size = 9,
face = "bold"),
strip.text         = element_text(color = art_dark, size = 9,
face = "bold"),
strip.background   = element_rect(fill = art_cream, color = NA)
)
}
#| echo: false
#| warning: false
#| message: false
dir.create(here("charts"), showWarnings = FALSE)
nat_avg <- mean(hrrp_clean$err > 1.0, na.rm = TRUE) * 100
state_pct <- hrrp_clean %>%
group_by(state) %>%
summarise(
pct_penalized = mean(err > 1.0, na.rm = TRUE) * 100,
n = n(),
.groups = "drop"
) %>%
filter(pct_penalized > nat_avg) %>%
mutate(state = fct_reorder(state, pct_penalized))
ggplot(state_pct, aes(x = pct_penalized, y = state)) +
geom_col(fill = "#C0392B", width = 0.65) +
geom_vline(xintercept = nat_avg, linetype = "dashed",
color = "#1C1C1E", linewidth = 0.5) +
geom_text(
aes(label = paste0(round(pct_penalized, 1), "%")),
hjust = -0.2, size = 2.9, color = "#1C1C1E", family = "sans"
) +
annotate(
"text",
x     = nat_avg + 0.6,
y     = nrow(state_pct) + 0.6,
label = paste0("Nat'l avg: ", round(nat_avg, 1), "%"),
hjust = 0, vjust = 1,
size  = 2.8, color = "#6B6B6B", family = "sans", fontface = "italic"
) +
scale_x_continuous(
labels = function(x) paste0(x, "%"),
expand = expansion(mult = c(0, 0.14))
) +
labs(
title    = "Which States Have the Most Penalized Hospitals?",
subtitle = "Above-average states only — where more hospital-condition pairs exceed the 1.0 ERR threshold than the national rate",
x        = "% of Hospital-Condition Pairs with ERR > 1.0",
y        = NULL,
caption  = "Source: CMS Hospital Readmissions Reduction Program (HRRP) | Artometrics"
) +
theme_artometrics() +
theme(
panel.grid.major.y = element_blank(),
panel.grid.major.x = element_line(color = "#D5D5D5", linewidth = 0.3)
)
ggsave(here("charts", "chart1_states_penalized.png"),
width = 10, height = 7, dpi = 300, bg = "#FAFAF8")
