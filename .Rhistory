geom_vline(xintercept = 1.0, color = "#1C1C1E", linewidth = 0.6) +
geom_text(
aes(label = sprintf("%.4f", avg_err)),
hjust = -0.35, size = 3.2, color = "#1C1C1E", family = "sans"
) +
scale_x_continuous(
limits = c(x_min, x_max + 0.0012),
labels = function(x) sprintf("%.4f", x),
expand = expansion(mult = c(0.01, 0.08))
) +
annotate(
"text", x = 1.0, y = 6.6,
label = "ERR = 1.0\n(no excess)", hjust = 0.5, vjust = 0,
size = 2.8, color = "#6B6B6B", family = "sans"
) +
labs(
title = "Excess Readmission Ratio by Condition",
subtitle = "All six conditions exceed 1.0 — but the spread is measured in thousandths",
x = "Average Excess Readmission Ratio (ERR)",
y = NULL,
caption = "Source: CMS HRRP | Artometrics"
) +
theme_artometrics() +
theme(
panel.grid.major.y = element_blank(),
panel.grid.major.x = element_line(color = "#D5D5D5", linewidth = 0.3)
)
ggsave(here("charts", "chart2_err_by_condition.png"), width = 10, height = 6, dpi = 300, bg = "#FAFAF8")
